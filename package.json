{
  "name": "@ehr-bridge/sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for EHR Bridge integration. Convert database schemas to FHIR, validate, and sync with healthcare systems.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehr-bridge/ehr-bridge-sdk.git"
  },
  "homepage": "https://github.com/ehr-bridge/ehr-bridge-sdk#readme",
  "bugs": {
    "url": "https://github.com/ehr-bridge/ehr-bridge-sdk/issues"
  },
  "dependencies": {
    "@medplum/fhirtypes": "^5.1.7",
    "@medplum/core": "^5.1.7",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "prettier": "^3.0.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "keywords": [
    "ehr",
    "fhir",
    "healthcare",
    "integration",
    "health-it",
    "interoperability",
    "data-exchange",
    "converter",
    "mapper",
    "database",
    "mysql",
    "mongodb",
    "postgresql",
    "firestore",
    "validation",
    "api-client"
  ],
  "author": "EHR Bridge Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
